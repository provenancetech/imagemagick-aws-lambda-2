# Versions compiled into the layer. Keep these aligned with the base image in
# ./Dockerfile; .github/workflows/ci.yml recompiles everything on every pull
# request, so a bump that no longer builds fails before it can be deployed.
LIBPNG_VERSION ?= 1.6.59
LIBJPG_VERSION ?= 9f
OPENJP2_VERSION ?= 2.5.4
LIBTIFF_VERSION ?= 4.7.2
BZIP2_VERSION ?= 1.0.8
LIBWEBP_VERSION ?= 1.6.0
IMAGEMAGICK_VERSION ?= 7.1.2-35
LIBHEIF_VERSION ?= 1.23.7
LIBDE265_VERSION ?= 1.1.3
LCMS_VERSION ?= 2.20

TARGET_DIR ?= /opt/
PROJECT_ROOT = $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
CACHE_DIR=$(PROJECT_ROOT)build/cache

# .ONESHELL runs an entire recipe in one shell, but make only reports that
# shell's final exit status, so a failed configure or download in the middle of
# a recipe used to be masked by a later command. These flags make the build
# fail on the first error instead.
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.ONESHELL:

# The ImageMagick compile dominates wall clock time, so use every core the CI
# runner offers (nproc comes from coreutils in the build image).
NPROC := $(shell nproc)
MAKEJ := -j$(NPROC)

# Downloads go over HTTPS and retry: a dropped connection should not cost a
# full CI run. -o keeps the file name stable even when a URL redirects to a
# different host path (GitHub archives do).
CURL := curl -fL --retry 3 --retry-all-errors

CONFIGURE = PKG_CONFIG_PATH=$(CACHE_DIR)/lib/pkgconfig \
	./configure \
		CPPFLAGS=-I$(CACHE_DIR)/include \
		LDFLAGS=-L$(CACHE_DIR)/lib \
		--disable-dependency-tracking \
		--disable-shared \
		--enable-static \
		--prefix=$(CACHE_DIR)

## libde265
LIBDE265_SOURCE=libde265-$(LIBDE265_VERSION).tar.gz

$(LIBDE265_SOURCE):
	$(CURL) -o $(LIBDE265_SOURCE) https://github.com/strukturag/libde265/releases/download/v$(LIBDE265_VERSION)/$(LIBDE265_SOURCE)

$(CACHE_DIR)/lib/libde265.a: $(LIBDE265_SOURCE)
	tar xf $<
	cd libde265-$(LIBDE265_VERSION)
	cmake -S . -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$(CACHE_DIR) \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=OFF \
		-DENABLE_SDL=OFF
	cmake --build build $(MAKEJ)
	cmake --install build

## libheif
LIBHEIF_SOURCE=libheif-$(LIBHEIF_VERSION).tar.gz

$(LIBHEIF_SOURCE):
	$(CURL) -o $(LIBHEIF_SOURCE) https://github.com/strukturag/libheif/releases/download/v$(LIBHEIF_VERSION)/$(LIBHEIF_SOURCE)

# libde265 provides HEVC decoding (the .heic format) and libwebp provides the
# libsharpyuv colour transforms, so both must be in the cache first.
$(CACHE_DIR)/lib/libheif.a: $(LIBHEIF_SOURCE) $(CACHE_DIR)/lib/libde265.a $(CACHE_DIR)/lib/libwebp.a
	tar xf $<
	cd libheif-$(LIBHEIF_VERSION)
	PKG_CONFIG_PATH=$(CACHE_DIR)/lib/pkgconfig cmake -S . -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$(CACHE_DIR) \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_PREFIX_PATH=$(CACHE_DIR) \
		-DBUILD_SHARED_LIBS=OFF \
		-DWITH_EXAMPLES=OFF \
		-DBUILD_TESTING=OFF \
		-DBUILD_DOCUMENTATION=OFF \
		-DWITH_GDK_PIXBUF=OFF \
		-DENABLE_PLUGIN_LOADING=OFF
	cmake --build build $(MAKEJ)
	cmake --install build

## libjpg

LIBJPG_SOURCE=jpegsrc.v$(LIBJPG_VERSION).tar.gz

$(LIBJPG_SOURCE):
	$(CURL) -o $(LIBJPG_SOURCE) https://ijg.org/files/$(LIBJPG_SOURCE)

$(CACHE_DIR)/lib/libjpeg.a: $(LIBJPG_SOURCE)
	tar xf $<
	cd jpeg-$(LIBJPG_VERSION)
	$(CONFIGURE)
	make $(MAKEJ)
	make install


## libpng

LIBPNG_SOURCE=libpng-$(LIBPNG_VERSION).tar.xz

$(LIBPNG_SOURCE):
	$(CURL) -o $(LIBPNG_SOURCE) https://download.sourceforge.net/libpng/$(LIBPNG_SOURCE)

$(CACHE_DIR)/lib/libpng.a: $(LIBPNG_SOURCE)
	tar xf $<
	cd libpng-$(LIBPNG_VERSION)
	$(CONFIGURE)
	make $(MAKEJ)
	make install

# libbz2

BZIP2_SOURCE=bzip2-$(BZIP2_VERSION).tar.gz

$(BZIP2_SOURCE):
	$(CURL) -o $(BZIP2_SOURCE) https://sourceware.org/pub/bzip2/$(BZIP2_SOURCE)

$(CACHE_DIR)/lib/libbz2.a: $(BZIP2_SOURCE)
	tar xf $<
	cd bzip2-$(BZIP2_VERSION)
	make $(MAKEJ) libbz2.a
	make install PREFIX=$(CACHE_DIR)

# libtiff

LIBTIFF_SOURCE=tiff-$(LIBTIFF_VERSION).tar.gz

$(LIBTIFF_SOURCE):
	$(CURL) -o $(LIBTIFF_SOURCE) https://download.osgeo.org/libtiff/$(LIBTIFF_SOURCE)

$(CACHE_DIR)/lib/libtiff.a: $(LIBTIFF_SOURCE) $(CACHE_DIR)/lib/libjpeg.a
	tar xf $<
	cd tiff-$(LIBTIFF_VERSION)
	$(CONFIGURE)
	make $(MAKEJ)
	make install

# libwebp

LIBWEBP_SOURCE=libwebp-$(LIBWEBP_VERSION).tar.gz

$(LIBWEBP_SOURCE):
	$(CURL) -o $(LIBWEBP_SOURCE) https://github.com/webmproject/libwebp/archive/v$(LIBWEBP_VERSION).tar.gz

$(CACHE_DIR)/lib/libwebp.a: $(LIBWEBP_SOURCE)
	tar xf $<
	cd libwebp-$(LIBWEBP_VERSION)
	sh autogen.sh
	$(CONFIGURE)
	make $(MAKEJ)
	make install

LCMS_SOURCE=lcms2-$(LCMS_VERSION).tar.gz

$(LCMS_SOURCE):
	$(CURL) -o $(LCMS_SOURCE) https://github.com/mm2/Little-CMS/releases/download/lcms$(LCMS_VERSION)/$(LCMS_SOURCE)

$(CACHE_DIR)/lib/liblcms2.a: $(LCMS_SOURCE)
	tar xf $<
	cd lcms2-$(LCMS_VERSION)
	sh autogen.sh
	$(CONFIGURE)
	make $(MAKEJ)
	make install

## libopenjp2

OPENJP2_SOURCE=openjp2-$(OPENJP2_VERSION).tar.gz

$(OPENJP2_SOURCE):
	$(CURL) -o $(OPENJP2_SOURCE) https://github.com/uclouvain/openjpeg/archive/v$(OPENJP2_VERSION).tar.gz


$(CACHE_DIR)/lib/libopenjp2.a: $(OPENJP2_SOURCE) $(CACHE_DIR)/lib/libpng.a $(CACHE_DIR)/lib/libtiff.a
	tar xf $<
	cd openjpeg-$(OPENJP2_VERSION)
	mkdir -p build
	cd build
	PKG_CONFIG_PATH=$(CACHE_DIR)/lib/pkgconfig cmake .. \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$(CACHE_DIR) \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS:bool=off \
		-DBUILD_CODEC:bool=off
	make clean
	make install $(MAKEJ)


## ImageMagick

IMAGE_MAGICK_SOURCE=ImageMagick-$(IMAGEMAGICK_VERSION).tar.gz

$(IMAGE_MAGICK_SOURCE):
	$(CURL) -o $(IMAGE_MAGICK_SOURCE) https://github.com/ImageMagick/ImageMagick/archive/$(IMAGEMAGICK_VERSION).tar.gz


LIBS:=$(CACHE_DIR)/lib/libjpeg.a \
	$(CACHE_DIR)/lib/libpng.a \
	$(CACHE_DIR)/lib/libopenjp2.a \
	$(CACHE_DIR)/lib/libtiff.a \
	$(CACHE_DIR)/lib/libbz2.a \
	$(CACHE_DIR)/lib/libwebp.a \
	$(CACHE_DIR)/lib/libde265.a \
	$(CACHE_DIR)/lib/libheif.a \
	$(CACHE_DIR)/lib/liblcms2.a

# pkg-config --libs libheif reports only -lheif: libheif keeps its decoder
# dependency (libde265) in Libs.private/Requires.private and ImageMagick's
# configure does not ask for static flags, so the link fails with undefined
# de265_* symbols. Ask pkg-config for the static flags here and hand them to
# configure as LIBS, which autoconf appends after every other library on the
# link line - the ordering static archives require. This also fails loudly if
# libheif.pc is missing, instead of silently producing a layer without HEIC.
$(TARGET_DIR)/bin/identify: $(IMAGE_MAGICK_SOURCE) $(LIBS)
	tar xf $<
	cd ImageMagick-$(IMAGEMAGICK_VERSION)
	LIBS="$$(PKG_CONFIG_PATH=$(CACHE_DIR)/lib/pkgconfig pkg-config --static --libs libheif)" \
	PKG_CONFIG_PATH=$(CACHE_DIR)/lib/pkgconfig \
		./configure \
		CPPFLAGS=-I$(CACHE_DIR)/include \
		LDFLAGS="-L$(CACHE_DIR)/lib -lstdc++" \
		--disable-dependency-tracking \
		--disable-shared \
		--enable-static \
		--with-heic=yes \
		--with-lcms=yes \
		--prefix=$(TARGET_DIR) \
		--enable-delegate-build \
		--without-modules \
		--disable-docs \
		--without-magick-plus-plus \
		--without-perl \
		--without-x \
		--disable-openmp
	make clean
	make $(MAKEJ) all
	make install

libs: $(LIBS)

all: $(TARGET_DIR)/bin/identify
